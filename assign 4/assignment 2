import math

p = 3
q = 11
m = 3

if p == q:
    print("p and q must be different prime numbers")
    exit()

n = p * q
phi = (p - 1) * (q - 1)

for e in range(2, phi):
    if math.gcd(e, phi) == 1:
        break

for d in range(1, phi):
    if (d * e) % phi == 1:
        break

c = pow(m, e, n)
decrypted = pow(c, d, n)

print("p =", p)
print("q =", q)
print("n =", n)
print("phi =", phi)
print("e =", e)
print("d =", d)
print("Original Message =", m)
print("Encrypted Message =", c)
print("Decrypted Message =", decrypted)

